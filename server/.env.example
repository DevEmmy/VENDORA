NODE_ENV=development
PORT=8080
# Copy actual URLs from Supabase Connect. Runtime and migration roles differ.
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=
DATABASE_TLS=false
# Download the provider's CA certificate and set its path when using hosted PostgreSQL.
DATABASE_CA_FILE=
DATABASE_POOL_MAX=5
DATABASE_TRANSACTION_MAX_WAIT_MS=15000
DATABASE_TRANSACTION_TIMEOUT_MS=20000
REDIS_URL=
CORS_ORIGINS=
# Browser-visible API origin. Prefer the frontend origin with a /api proxy.
PUBLIC_API_ORIGIN=
# For app.example.com -> api.example.com, set example.com (registrable domain).
COOKIE_SITE_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY=
ENABLE_DEV_ROUTES=false
ENABLE_WHATSAPP=false
# Off by default. Validates/cuts over each authorized snapshot shop at login.
INVENTORY_LAZY_BACKFILL=false
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=vendora-web
AUTH_KEY_ID=vendora-2026-01
# Bounded tolerance for retrying only the immediately previous refresh token; 0 disables.
AUTH_REFRESH_REUSE_GRACE_MS=10000
# PEM keys may contain escaped newline sequences. Generate an RSA pair >=2048 bits.
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
# Independent cryptographically random secrets; no example/default credentials.
DELIVERY_ENCRYPTION_KEY=
# HTTPS trusted delivery gateway contract is documented in backend-auth.md.
DELIVERY_URL=
DELIVERY_TOKEN=
RECOVERY_ORIGIN=
# Configure both to enable WhatsApp webhooks. No default verification secret.
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Phase 2 voice inventory. Backend only; never use VITE_ prefixes for these keys.
YARNGPT_API_KEY=
YARNGPT_BASE_URL=https://api.yarngpt.ai
YARNGPT_TTS_VOICE=
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Required in live mode: choose a model supported by your provider account.
LLM_MODEL=
# Optional full API root, e.g. an OpenAI-compatible endpoint ending in /v1.
LLM_BASE_URL=
VOICE_MOCK_MODE=false
VOICE_ASR_TIMEOUT_MS=15000
VOICE_LLM_TIMEOUT_MS=10000
# Live ASR uses a server-side YarnGPT WebSocket and browser PCM/SSE relay.
VOICE_STREAM_PROVIDER=yarngpt
# Pending proposals expire after five minutes; confirmed receipts remain replayable.
VOICE_PENDING_TTL_MS=300000
