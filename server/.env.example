NODE_ENV=development
PORT=8080
# Copy actual URLs from Supabase Connect. Runtime and migration roles differ.
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=
DATABASE_TLS=false
# Download the provider's CA certificate and set its path when using hosted PostgreSQL.
DATABASE_CA_FILE=
DATABASE_POOL_MAX=5
REDIS_URL=
CORS_ORIGINS=
COOKIE_SECURE=false
TRUST_PROXY=
ENABLE_DEV_ROUTES=false
ENABLE_WHATSAPP=false
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=vendora-web
AUTH_KEY_ID=vendora-2026-01
# Bounded tolerance for retrying only the immediately previous refresh token; 0 disables.
AUTH_REFRESH_REUSE_GRACE_MS=10000
# PEM keys may contain escaped newline sequences. Generate an RSA pair >=2048 bits.
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
# Independent cryptographically random secrets; no example/default credentials.
DELIVERY_ENCRYPTION_KEY=
# HTTPS trusted delivery gateway contract is documented in backend-auth.md.
DELIVERY_URL=
DELIVERY_TOKEN=
RECOVERY_ORIGIN=
# Configure both to enable WhatsApp webhooks. No default verification secret.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
