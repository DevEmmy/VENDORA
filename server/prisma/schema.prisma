generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas = ["vendora"]
}

enum InventoryMode {
  SNAPSHOT
  RELATIONAL
  @@map("inventory_mode")
  @@schema("vendora")
}

enum SaleStatus {
  COMPLETED
  REVERSED
  @@map("sale_status")
  @@schema("vendora")
}

enum StockMovementType {
  OPENING
  RESTOCK
  SALE
  SALE_REVERSAL
  COUNT_CORRECTION
  LEGACY_ADJUSTMENT
  @@map("stock_movement_type")
  @@schema("vendora")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String?
  phone String @unique
  passwordHash String
  phoneVerifiedAt DateTime?
  status String @default("pending")
  authVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  memberships Membership[]
  challenges VerificationChallenge[]
  recoveryTokens RecoveryToken[]
  recoveryDestination String?
  recoveryVerifiedAt DateTime?
  productsCreated Product[] @relation("ProductCreator")
  salesCreated Sale[] @relation("SaleCreator")
  stockMovements StockMovement[] @relation("StockMovementCreator")
  inventoryOperations InventoryOperation[]
  paymentsCreated Payment[] @relation("PaymentCreator")
  @@map("users")
  @@schema("vendora")
}

model Business {
  id String @id @default(uuid()) @db.Uuid
  businessName String?
  businessType String?
  city String?
  phone String @unique
  createdAt DateTime @default(now())
  whatsappLinkedAt DateTime?
  memberships Membership[]
  resources ResourceOwnership[]
  snapshot BusinessSnapshot?
  submissions Submission[]
  entries ChannelEntry[]
  products Product[]
  customers Customer[]
  sales Sale[]
  saleItems SaleItem[]
  payments Payment[]
  expenses Expense[]
  inventoryMode InventoryMode @default(SNAPSHOT) @map("inventory_mode")
  inventoryMigratedAt DateTime? @map("inventory_migrated_at") @db.Timestamptz(3)
  inventoryMigrationReport Json? @map("inventory_migration_report")
  syncSeq BigInt @default(0) @map("sync_seq")
  invoiceSeq BigInt @default(0) @map("invoice_seq")
  stockMovements StockMovement[]
  syncChanges SyncChange[]
  inventoryOperations InventoryOperation[]
  notifications Notification[]
  @@map("businesses")
  @@schema("vendora")
}

model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  businessId String @db.Uuid
  role String
  permissions String[]
  status String @default("active")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([userId, businessId])
  @@index([businessId, status])
  @@map("business_memberships")
  @@schema("vendora")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  csrf String
  authVersion Int
  authenticatedAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  idleExpiresAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  mfaLevel Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("vendora")
}

model RefreshToken {
  digest String @id
  sessionId String @db.Uuid
  parentDigest String? @unique
  expiresAt DateTime
  consumedAt DateTime?
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent RefreshToken? @relation("rotation", fields: [parentDigest], references: [digest])
  replacement RefreshToken? @relation("rotation")
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("vendora")
}

model VerificationChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  destination String
  purpose String
  digest String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("verification_challenges")
  @@schema("vendora")
}

model RecoveryToken {
  digest String @id
  userId String @db.Uuid
  purpose String
  expiresAt DateTime
  consumedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("recovery_tokens")
  @@schema("vendora")
}

model PreAuth {
  digest String @id
  csrf String
  expiresAt DateTime
  @@index([expiresAt])
  @@map("pre_auth")
  @@schema("vendora")
}

model ResourceOwnership {
  kind String
  resourceId String
  businessId String @db.Uuid
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@id([kind, resourceId])
  @@index([businessId, kind])
  @@map("resource_ownership")
  @@schema("vendora")
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  action String
  outcome String
  userId String? @db.Uuid
  sessionId String? @db.Uuid
  requestId String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("auth_audit_events")
  @@schema("vendora")
}

model WebhookEvent {
  id String @id
  provider String
  payload Json
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@index([processedAt, createdAt])
  @@map("webhook_events")
  @@schema("vendora")
}

model BusinessSnapshot {
  businessId String @id @db.Uuid
  state Json
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@map("business_snapshots")
  @@schema("vendora")
}

model Submission {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  metadata Json
  file Bytes
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId, createdAt])
  @@map("submissions")
  @@schema("vendora")
}

model DeliveryJob {
  id String @id @default(uuid()) @db.Uuid
  ciphertext String
  expiresAt DateTime
  leaseUntil DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([leaseUntil, expiresAt])
  @@map("delivery_jobs")
  @@schema("vendora")
}

model ChannelEntry {
  seq Int @id @default(autoincrement())
  businessId String @db.Uuid
  phone String
  source String
  text String?
  op Json
  at DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, seq])
  @@map("channel_entries")
  @@schema("vendora")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name String
  unit String @default("piece")
  aliases String[] @default([])
  clientId String? @map("client_id") @db.Uuid
  legacyId String? @map("legacy_id")
  createdById String? @map("created_by_id") @db.Uuid
  createdBy User? @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// Integer kobo (NGN smallest unit).
  unitPrice BigInt @map("unit_price")
  /// Integer kobo (NGN smallest unit).
  costPrice BigInt? @map("cost_price")
  stockQty Decimal @default(0) @map("stock_qty") @db.Decimal(12, 3)
  lowStockAt Decimal @default(5) @map("low_stock_at") @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  syncSeq BigInt @default(0) @map("sync_seq")
  saleItems SaleItem[]
  stockMovements StockMovement[]
  notifications Notification[]
  @@unique([businessId, id], map: "products_business_id_id_key")
  @@unique([businessId, clientId], map: "products_business_id_client_id_key")
  @@unique([businessId, legacyId], map: "products_business_id_legacy_id_key")
  @@index([businessId, syncSeq])
  @@index([name(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([businessId], map: "products_business_id_idx")
  @@map("products")
  @@schema("vendora")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  legacyId String? @map("legacy_id")
  businessId String @map("business_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name String
  phone String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sales Sale[]
  @@unique([businessId, id], map: "customers_business_id_id_key")
  @@unique([businessId, clientId], map: "customers_business_id_client_id_key")
  @@unique([businessId, legacyId], map: "customers_business_id_legacy_id_key")
  @@index([name(ops: raw("public.gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([businessId], map: "customers_business_id_idx")
  @@map("customers")
  @@schema("vendora")
}

model Sale {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId String? @map("customer_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  legacyId String? @map("legacy_id")
  invoiceNo String? @map("invoice_no")
  createdById String? @map("created_by_id") @db.Uuid
  createdBy User? @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status SaleStatus @default(COMPLETED)
  reversedSaleId String? @map("reversed_sale_id") @db.Uuid
  reversedSale Sale? @relation("SaleReversal", fields: [businessId, reversedSaleId], references: [businessId, id], onDelete: NoAction, onUpdate: NoAction, map: "sales_reversed_sale_fk")
  reversal Sale? @relation("SaleReversal")
  source String @default("app")
  metadata Json @default("{}")
  /// Integer kobo (NGN smallest unit). Debt = total - amountPaid.
  total BigInt
  /// Integer kobo; includes checkout tender and subsequent repayments.
  amountPaid BigInt @default(0) @map("amount_paid")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  syncSeq BigInt @default(0) @map("sync_seq")
  customer Customer? @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  items SaleItem[]
  payments Payment[]
  stockMovements StockMovement[]
  @@unique([businessId, id], map: "sales_business_id_id_key")
  @@unique([businessId, clientId], map: "sales_business_id_client_id_key")
  @@unique([businessId, legacyId], map: "sales_business_id_legacy_id_key")
  @@unique([businessId, invoiceNo])
  @@unique([businessId, reversedSaleId], map: "sales_business_id_reversed_sale_id_key")
  @@index([businessId, syncSeq])
  @@index([businessId, createdAt], map: "sales_business_id_created_at_idx")
  @@index([businessId, customerId], map: "sales_business_id_customer_id_idx")
  @@index([businessId], map: "sales_business_id_idx")
  @@map("sales")
  @@schema("vendora")
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  saleId String @map("sale_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  productName String @default("") @map("product_name")
  unit String @default("piece")
  /// Integer kobo; price snapshot at time of sale.
  unitPrice BigInt @map("unit_price")
  sale Sale @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Cascade)
  product Product @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  @@index([saleId], map: "sale_items_sale_id_idx")
  @@index([businessId, productId], map: "sale_items_business_id_product_id_idx")
  @@index([businessId], map: "sale_items_business_id_idx")
  @@map("sale_items")
  @@schema("vendora")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  businessId String @map("business_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  saleId String @map("sale_id") @db.Uuid
  /// Integer kobo; subsequent debt repayment only.
  amount BigInt
  createdById String? @map("created_by_id") @db.Uuid
  createdBy User? @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sale Sale @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Cascade)
  @@index([saleId], map: "payments_sale_id_idx")
  @@unique([businessId, clientId], map: "payments_business_id_client_id_key")
  @@index([businessId], map: "payments_business_id_idx")
  @@map("payments")
  @@schema("vendora")
}

model Expense {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  description String
  /// Integer kobo (NGN smallest unit).
  amount BigInt
  category String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([businessId, createdAt], map: "expenses_business_id_created_at_idx")
  @@index([businessId], map: "expenses_business_id_idx")
  @@map("expenses")
  @@schema("vendora")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  saleId String? @map("sale_id") @db.Uuid
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  sale Sale? @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Restrict)
  type StockMovementType
  quantity Decimal @db.Decimal(12, 3)
  quantityBefore Decimal @map("quantity_before") @db.Decimal(12, 3)
  quantityAfter Decimal @map("quantity_after") @db.Decimal(12, 3)
  source String
  referenceId String? @map("reference_id")
  createdById String? @map("created_by_id") @db.Uuid
  createdBy User? @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  clientId String? @map("client_id") @db.Uuid
  legacyId String? @map("legacy_id")
  oversold Boolean @default(false)
  metadata Json @default("{}")
  syncSeq BigInt @default(0) @map("sync_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Posted movements are immutable; corrections/reversals append another row.
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  @@unique([businessId, id])
  @@unique([businessId, clientId])
  @@unique([businessId, legacyId])
  @@index([businessId, productId, createdAt])
  @@index([businessId, syncSeq])
  @@map("stock_movements")
  @@schema("vendora")
}

model SyncChange {
  businessId String @map("business_id") @db.Uuid
  seq BigInt
  entity String
  entityId String @map("entity_id") @db.Uuid
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@id([businessId, seq])
  @@map("sync_changes")
  @@schema("vendora")
}

model InventoryOperation {
  businessId String @map("business_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  action String
  requestHash String @map("request_hash")
  result Json
  metadata Json @default("{}")
  createdById String @map("created_by_id") @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@id([businessId, clientId])
  @@map("inventory_operations")
  @@schema("vendora")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  type String
  message String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  @@index([businessId, readAt, createdAt])
  @@map("notifications")
  @@schema("vendora")
}

model VoiceLog {
  id String @id @default(uuid()) @db.Uuid
  businessId String @map("business_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  transcript String @default("")
  parsed Json @default("{}")
  confidence Float @default(0)
  status String @default("processing")
  asrJobId String? @map("asr_job_id")
  audioSeconds Decimal? @map("audio_seconds")
  latencyMs Int? @map("latency_ms")
  errorCode String? @map("error_code")
  candidates Json @default("[]")
  readbackText String? @map("readback_text")
  movementId String? @map("movement_id") @db.Uuid
  result Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], map: "voice_logs_business_cursor")
  @@map("voice_logs")
  @@schema("vendora")
}
