{
  "name": "vendora-server",
  "version": "0.1.0",
  "private": true,
  "description": "Vendora backend: WhatsApp channel, Wema/ALAT integration layer (mock + live adapter), and app sync.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "node scripts/lint.mjs",
    "build": "prisma generate && tsc",
    "test": "tsx --test test/*.test.ts test/*.test.js",
    "test:integration": "tsx --test --test-force-exit test/integration/*.test.ts",
    "test:integration:isolated": "tsx scripts/test-database.ts integration",
    "test:reproductions": "tsx --test --test-force-exit test/reproductions/*.test.ts",
    "test:browser": "npm --prefix ../web run build && playwright test",
    "db:test:migrate": "tsx scripts/test-database.ts migrate",
    "db:test:reset": "tsx scripts/test-database.ts reset",
    "db:deploy": "prisma migrate deploy",
    "inventory:backfill": "tsx scripts/inventory-backfill.ts",
    "smoke:cookies": "tsx scripts/cookie-smoke.ts",
    "db:dev": "prisma migrate dev",
    "phase1:check": "tsx scripts/phase1-check.ts",
    "phase1:seed": "tsx scripts/phase1-seed.ts",
    "phase1:verify": "tsx scripts/phase1-verify.ts",
    "phase1:down": "tsx scripts/phase1-down.ts",
    "phase1:constraints": "tsx scripts/phase1-constraints.ts",
    "secrets": "node scripts/generate-secrets.mjs"
  },
  "engines": {
    "node": ">=22.12 <23 || >=24 <25"
  },
  "license": "UNLICENSED",
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "^4.22.3",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
