{
  "name": "vendora-server",
  "version": "0.1.0",
  "private": true,
  "description": "Vendora backend: WhatsApp channel, Wema/ALAT integration layer (mock + live adapter), and app sync.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "prisma generate && tsc",
    "test": "tsx --test test/*.test.ts test/*.test.js",
    "test:integration": "tsx --test --test-force-exit test/integration/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "db:dev": "prisma migrate dev"
  },
  "engines": {
    "node": ">=22.12 <23 || >=24 <25"
  },
  "license": "UNLICENSED",
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "^4.22.3",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "nodemon": "^3.1.14",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
